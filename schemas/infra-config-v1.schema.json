{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syncom-systems/dev-platform/schemas/infra-config-v1.schema.json",
  "title": "dev-platform.infra-config/v1",
  "description": "An organization's declared infrastructure configuration (ADR 0023), projected onto per-repository dev-platform.infra/v1 profiles and frozen into configuration releases. Shape only: cross-references (runner groups, caches, credential classes, runners, repositories), secret-shaped values and the safety rules are enforced in code (dev_platform.infra_config). A declaration is not a registration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "runners", "repositories"],
  "properties": {
    "schema": {"const": "dev-platform.infra-config/v1"},
    "owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
    "runners": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "placement", "labels", "os", "arch", "isolation", "trust"],
      "properties": {
        "id": {"type": "string"}, "description": {"type": "string"},
        "placement": {"enum": ["github-hosted", "self-hosted"]},
        "runner_group": {"type": "string", "description": "required for self-hosted; must be declared in runner_groups"},
        "labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "os": {"enum": ["linux", "macos"]}, "arch": {"enum": ["x86_64", "arm64"]},
        "isolation": {"enum": ["ephemeral", "persistent"]},
        "trust": {"enum": ["public", "trusted"], "description": "which events the runner may serve: public also serves untrusted events; never the event trust itself"},
        "credentials": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "description": "credential classes; each needs a credential_ref"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "cache": {"enum": ["none", "read-only", "read-write"]}}}},
    "runner_groups": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "repositories", "allows_public_repositories"],
      "properties": {"name": {"type": "string"}, "repositories": {"type": "array", "items": {"type": "string"}},
                     "allows_public_repositories": {"type": "boolean"}, "restricted_to_workflows": {"type": "boolean"}}}},
    "caches": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "modes"],
      "properties": {"id": {"type": "string"}, "endpoint": {"type": "string"}, "credential_ref": {"type": "string"},
                     "modes": {"type": "object", "additionalProperties": false, "required": ["trusted", "untrusted"],
                               "properties": {"trusted": {"enum": ["none", "read-only", "read-write"]}, "untrusted": {"const": "none"}}}}}},
    "credential_refs": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "class", "provider", "binding"],
      "description": "references only, never secret values",
      "properties": {"id": {"type": "string"}, "class": {"type": "string"}, "provider": {"type": "string"},
                     "scope": {"type": "string"}, "binding": {"enum": ["unbound", "bound"]}}}},
    "repositories": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "visibility", "runners"],
      "properties": {"name": {"type": "string"}, "visibility": {"enum": ["public", "private", "internal"]},
                     "runners": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                     "cache": {"type": "string"},
                     "desired": {"type": "object", "additionalProperties": false, "properties": {
                       "default_token": {"enum": ["read", "write"]},
                       "fork_pr_approval": {"enum": ["first_time_contributors_new_to_github", "first_time_contributors", "all_external_contributors"]},
                       "runner_registration": {"enum": ["none", "org-group"]}}}}}},
    "admission": {"type": "object", "additionalProperties": false, "properties": {
      "forbidden_triggers": {"type": "array", "uniqueItems": true, "items": {"enum": ["push", "schedule", "workflow_dispatch", "pull_request", "pull_request_target", "workflow_run", "release"]}},
      "protected_environments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
