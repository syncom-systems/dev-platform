{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syncom-systems/dev-platform/schemas/infra-profile-v1.schema.json",
  "title": "dev-platform.infra/v1",
  "description": "The public/private boundary: runner inventory offered by an infrastructure provider. Runner ids are unique; a runner that offers credentials must have trust \"trusted\" (checked in code: JSON Schema cannot express uniqueness by property). Conformance kit: contracts/infra/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runners"],
  "properties": {
    "schema": {"const": "dev-platform.infra/v1"},
    "admission": {"type": "object", "additionalProperties": false, "description": "Optional, organization-owned admission policy for the generic PR checker (ADR 0018). Event trust is never configurable here.", "properties": {
      "forbidden_triggers": {"type": "array", "uniqueItems": true, "items": {"enum": ["push", "schedule", "workflow_dispatch", "pull_request", "pull_request_target", "workflow_run", "release"]}},
      "protected_environments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "runners": {"type": "array", "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "labels", "os", "arch", "isolation", "trust"],
      "if": {"required": ["credentials"], "properties": {"credentials": {"minItems": 1}}},
      "then": {"properties": {"trust": {"const": "trusted"}}},
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "os": {"enum": ["linux", "macos"]},
        "arch": {"enum": ["x86_64", "arm64"]},
        "isolation": {"enum": ["ephemeral", "persistent"]},
        "trust": {"enum": ["public", "trusted"]},
        "credentials": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}}
  }
}
