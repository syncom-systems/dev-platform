{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syncom-systems/dev-platform/schemas/trust-v1.schema.json",
  "title": "dev-platform.trust/v1",
  "description": "Who may produce a release. A valid signature does not imply trust; the signer must match this policy.",
  "type": "object",
  "required": [
    "schema",
    "oidc_issuer",
    "signers"
  ],
  "properties": {
    "schema": {
      "const": "dev-platform.trust/v1"
    },
    "oidc_issuer": {
      "type": "string"
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repo",
          "workflow",
          "ref_pattern"
        ]
      }
    },
    "require_github_hosted_runner": {
      "type": "boolean"
    },
    "stable_requires_authorization": {
      "const": true,
      "description": "Cannot be disabled: a stable release is accepted only with an authenticated approval."
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor"],
      "properties": {
        "predecessor": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false,
             "required": ["version", "archive_sha256", "tree_digest"],
             "properties": {
               "version": {"type": "string"},
               "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
               "tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}]}}
    },
    "require_environment_evidence": {
      "type": "boolean"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providers",
        "evidence_repo",
        "evidence_ref",
        "approvers"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "enum": [
              "github-signed-commit",
              "github-environment-approval"
            ]
          },
          "description": "Subset of the verifier's built-in registry; unknown providers fail closed."
        },
        "evidence_repo": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        },
        "environment_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "workflow", "ref"],
          "description": "Pinned acceptance workflow for the github-environment-approval provider.",
          "properties": {
            "repo": {"type": "string"},
            "workflow": {"type": "string"},
            "ref": {"type": "string"}
          }
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "provider",
              "login",
              "may_approve",
              "may_confer"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "provider": {
                "enum": [
                  "github-signed-commit",
                  "github-environment-approval"
                ]
              },
              "login": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "may_approve": {
                "type": "array",
                "items": {
                  "enum": [
                    "platform-release"
                  ]
                }
              },
              "may_confer": {
                "type": "array",
                "items": {
                  "enum": [
                    "platform-baseline"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
