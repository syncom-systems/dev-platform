{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syncom-systems/dev-platform/schemas/authorization-v1.schema.json",
  "title": "dev-platform.authorization/v1",
  "description": "A decision about a subject. Authenticity is verified by the consumer of the record from provider evidence (never taken from the record), authority comes from the trust policy, and scope can only narrow what the approver may confer. Git authorship is never an identity assertion.",
  "type": "object",
  "required": [
    "basis",
    "decided_at",
    "decided_by",
    "decision",
    "id",
    "retention",
    "schema",
    "subject"
  ],
  "properties": {
    "schema": {
      "const": "dev-platform.authorization/v1"
    },
    "id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "application-release",
            "platform-release",
            "change"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "revoked"
      ]
    },
    "decided_by": {
      "type": "object",
      "required": [
        "id",
        "role",
        "identity_assertion"
      ],
      "properties": {
        "identity_assertion": {
          "type": "object",
          "required": [
            "provider",
            "login",
            "path"
          ],
          "properties": {
            "provider": {
              "enum": [
                "github-signed-commit"
              ]
            },
            "login": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "pattern": "^authorizations/[A-Za-z0-9._-]+\\.json$"
            }
          }
        }
      }
    },
    "basis": {
      "type": "object"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "class",
        "until"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "confers"
      ],
      "properties": {
        "confers": {
          "type": "array",
          "items": {
            "enum": [
              "platform-baseline",
              "application-release-approval"
            ]
          },
          "minItems": 1,
          "description": "Exactly what the approval grants: platform-release subjects may confer only platform-baseline, application-release subjects only application-release-approval. Certification, qualification, deployment and consumer migration are never conferrable here."
        }
      }
    },
    "validity": {
      "type": "object",
      "properties": {
        "not_before": {
          "type": "string",
          "format": "date-time"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "platform-release"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "properties": {
              "confers": {
                "items": {
                  "const": "platform-baseline"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "application-release"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "properties": {
              "confers": {
                "items": {
                  "const": "application-release-approval"
                }
              }
            }
          }
        }
      }
    }
  ]
}
