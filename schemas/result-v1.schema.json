{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matssun/dev-platform/schemas/result-v1.schema.json",
  "title": "dev-platform.result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "project", "revision", "stage", "change_set", "executed",
               "environment", "checks", "unsatisfied_obligations", "regressions", "admission", "certification", "exit"],
  "properties": {
    "schema": {"const": "dev-platform.result/v1"},
    "platform": {"type": "object", "required": ["running_version", "mode", "pinned_version", "digest"],
                 "properties": {"running_version": {"type": "string"},
                                "mode": {"enum": ["pinned", "override", "self"]},
                                "pinned_version": {"type": ["string", "null"]},
                                "digest": {"type": ["string", "null"]}}},
    "environment": {"type": "object", "required": ["release", "profile", "conformant", "tools"],
                    "properties": {
                      "release": {"type": "object", "properties": {
                        "version": {"type": ["string", "null"]}, "tree_digest": {"type": ["string", "null"]},
                        "source_digest": {"type": ["string", "null"]}, "sbom_sha256": {"type": ["string", "null"]},
                        "synthesized": {"type": "boolean"}}},
                      "profile": {"type": ["string", "null"]},
                      "conformant": {"type": ["boolean", "null"]},
                      "identity_digest": {"type": "string"},
                      "assurance": {"enum": ["diagnostic", "certifiable"]},
                      "weak_tools": {"type": "array", "items": {"type": "string"}},
                      "tools": {"type": "array", "items": {"type": "object",
                        "required": ["name", "expected", "observed", "identity", "status"],
                        "properties": {"identity": {"enum": ["none", "version-only", "digest-verified", "bazel-declared", "bazel-locked"]},
                                       "status": {"enum": ["ok", "mismatch", "unavailable", "unreconciled"]}}}}}},
    "project": {"type": "object", "required": ["name", "assurance", "bazel_only"]},
    "revision": {"type": ["string", "null"]},
    "stage": {"enum": ["edit", "pre-commit", "pre-merge", "full"]},
    "change_set": {"type": "object", "required": ["known", "paths"],
                   "properties": {"known": {"type": "boolean"}, "paths": {"type": "array", "items": {"type": "string"}}}},
    "executed": {"type": "boolean"},
    "checks": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "adapter", "obligation", "cost", "selected", "reasons", "outcome", "state"],
      "properties": {
        "id": {"type": "string"}, "adapter": {"type": "string"},
        "obligation": {"enum": ["always", "change", "periodic"]},
        "cost": {"enum": ["fast", "slow"]},
        "selected": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}},
        "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": ["integer", "null"]},
        "runner": {"type": "object"},
        "outcome": {"enum": ["passed", "failed", "unavailable", "not_run"]},
        "state": {"enum": ["pending", "verified", "failed", "invalidated"]}}}},
    "unsatisfied_obligations": {"type": "array", "items": {"type": "string"}},
    "regressions": {"type": "array", "items": {"type": "string"}},
    "admission": {"enum": ["admitted", "blocked", null]},
    "certification": {"type": "object", "required": ["certified", "release_eligible", "blockers"]},
    "exit": {"enum": [0, 1]}
  }
}
