{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syncom-systems/dev-platform/schemas/app-trust-v1.schema.json",
  "title": "dev-platform.app-trust/v1",
  "description": "Who may approve an application's releases and which Dev Platform releases it accepts. Owned by the application, never by the platform: platform approvers have no authority here, and platform release acceptance is not an input (ADR 0019).",
  "type": "object",
  "required": [
    "schema",
    "authorization",
    "platform_releases"
  ],
  "properties": {
    "schema": {
      "const": "dev-platform.app-trust/v1"
    },
    "authorization": {
      "type": "object",
      "required": [
        "providers",
        "evidence_repo",
        "evidence_ref",
        "approvers"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "github-signed-commit"
            ]
          }
        },
        "evidence_repo": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "provider",
              "login",
              "may_approve",
              "may_confer",
              "applications"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "provider": {
                "enum": [
                  "github-signed-commit"
                ]
              },
              "login": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "may_approve": {
                "type": "array",
                "items": {
                  "enum": [
                    "application-release"
                  ]
                }
              },
              "may_confer": {
                "type": "array",
                "items": {
                  "enum": [
                    "application-release-approval"
                  ]
                }
              },
              "applications": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Explicit application names; there is no wildcard."
              }
            }
          }
        },
        "acknowledged_removals": {
          "type": "array",
          "description": "Operator-pinned recovery for an authorization record that was deleted from the evidence history. Each entry names the record path and the exact commit that removed it. The record is NOT dropped: it is read from the commit before its removal and judged there, so acknowledging the deletion of a revocation never un-revokes anything. Entries are part of the pinned policy (operator authority); an unlisted removal makes the current state indeterminate.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "commit"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^authorizations/[A-Za-z0-9._-]+\\.json$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "platform_releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "tree_digest"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "tree_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sbom_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "require_acceptance": {
            "const": true,
            "description": "the application also requires this Dev Platform release to be owner-accepted (verified by re-running the platform verifier); never an application approval"
          },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "description": "How long a CURRENT-state verification stays usable. The verifier records observed_at and valid_until; a consumer must re-verify rather than reuse an older record. Default 300 seconds. Authorization discovery itself is not configurable: it is mandatory for every current decision.",
      "required": [
        "max_age_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
